<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <VBox id="activeIdCard"
        class="zhrActiveIdWrapper"
        visible="{activeIDModel>/visible}">
        <HBox class="zhrActiveIdCard" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">

            <HBox alignItems="Center" class="zhrActiveIdContent">
                <VBox class="zhrActiveIdAvatar" justifyContent="Center" alignItems="Center">
                    <core:Icon src="sap-icon://employee-pane" class="zhrActiveIdIcon" decorative="true"/>
                </VBox>

                <HBox class="zhrActiveIdGrid" wrap="Wrap">
                    <VBox class="zhrActiveIdCol">
                        <Label id="activeIdNameLabel" text="{i18n>activeIdName}" class="zhrActiveIdLabel"/>
                        <Text text="{activeIDModel>/name}" class="zhrActiveIdName"
                            ariaLabelledBy="activeIdNameLabel"/>
                    </VBox>

                    <VBox class="zhrActiveIdCol">
                        <Label text="{i18n>activeIdNumber}" class="zhrActiveIdLabel"/>
                        <Text text="{activeIDModel>/IdNumber}" class="zhrActiveIdValue zhrPrimaryValue"/>
                    </VBox>

                    <VBox class="zhrActiveIdCol"
                        core:require="{ EdmDate: 'sap/ui/model/odata/type/Date' }">
                        <Label text="{i18n>activeIdIssueDate}" class="zhrActiveIdLabel"/>
                        <Text text="{ path: 'activeIDModel>/IssueDate', type: 'EdmDate', formatOptions: { style: 'medium' } }"
                            class="zhrActiveIdValue"/>
                    </VBox>

                    <VBox class="zhrActiveIdCol"
                        core:require="{ EdmDate: 'sap/ui/model/odata/type/Date' }">
                        <Label text="{i18n>activeIdExpiryDate}" class="zhrActiveIdLabel"/>
                        <Text text="{ path: 'activeIDModel>/ExpiryDate', type: 'EdmDate', formatOptions: { style: 'medium' } }"
                            class="zhrActiveIdValue"/>
                    </VBox>

                    <VBox class="zhrActiveIdCol">
                        <HBox alignItems="Center">
                            <Label text="{i18n>activeIdDaysToExpire}" class="zhrActiveIdLabel"/>
                            <core:Icon src="sap-icon://message-information"
                                class="zhrInfoIcon sapUiTinyMarginBegin"
                                tooltip="{activeIDModel>/renewInfo}"/>
                        </HBox>
                        <ObjectStatus text="{activeIDModel>/DaystoExpireText}"
                            state="{= ${activeIDModel>/daysCritical} ? 'Error' : 'None' }"
                            class="zhrActiveIdValue"/>
                    </VBox>
                </HBox>
            </HBox>

            <VBox class="zhrActiveIdStatusBox" justifyContent="Center">
                <ObjectStatus
                    text="{activeIDModel>/StatusText}"
                    state="{activeIDModel>/StatusState}"
                    class="zhrActiveIdStatusPill"/>
            </VBox>

        </HBox>
    </VBox>
</core:FragmentDefinition>
