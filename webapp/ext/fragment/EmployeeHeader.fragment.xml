<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!--
        Custom header facet (manifest "CustomEmployeeHeader").
        Data: ObjectPageExt "employeeInfo" model, loaded for the request's payroll number.
        Shown on the requester's own requests (for other requests the "Employee Details"
        subsection shows the same data).
    -->
    <VBox
        visible="{= ${employeeInfo>/isVisible} === true &amp;&amp; ${IsMyRequest} === true }"
        width="100%"
        class="violatorHeaderWrapper sapUiMediumMarginBottom"
        core:require="{ formatter: 'com/jhah/zhrjhahsecid1/ext/util/formatter' }">
        <HBox width="100%" class="nativeViolatorStrip" wrap="Wrap">

            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Label text="{i18n>empName}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/UserName}" class="violatorValue"/>
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Label text="{i18n>empPayrollNum}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/Pernr}" class="violatorValue"/>
                </HBox>
            </VBox>

            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Label text="{i18n>empJobTitle}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/PostionText}" class="violatorValue"/>
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Label text="{i18n>empDepartment}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/OrgText}" class="violatorValue"/>
                </HBox>
            </VBox>

            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Label text="{i18n>empBadge}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/BadgeNumber}" class="violatorValue"/>
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Label text="{i18n>empGovId}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/GovernmentID}" class="violatorValue"/>
                </HBox>
            </VBox>

            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Label text="{i18n>empDob}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{ path: 'employeeInfo>/DOB', formatter: 'formatter.yyyymmddToDisplay' }" class="violatorValue"/>
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Label text="{i18n>empGender}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/Gender}" class="violatorValue"/>
                </HBox>
            </VBox>

            <VBox class="violatorCol sapUiLargeMarginEnd sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Label text="{i18n>empEmail}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/EMail}" class="violatorValue"/>
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Label text="{i18n>empPhone}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/Phone}" class="violatorValue"/>
                </HBox>
            </VBox>

            <VBox class="violatorCol sapUiSmallMarginBottom">
                <HBox class="violatorRow sapUiTinyMarginBottom" alignItems="Center">
                    <Label text="{i18n>empBloodGroup}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/BloodGroup}" class="violatorValue"/>
                </HBox>
                <HBox class="violatorRow" alignItems="Center">
                    <Label text="{i18n>empUnit}" showColon="true" class="violatorLabel sapUiTinyMarginEnd"/>
                    <Text text="{employeeInfo>/UnitText}" class="violatorValue"/>
                </HBox>
            </VBox>

        </HBox>
    </VBox>
</core:FragmentDefinition>
