<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Custom subsection (manifest "Ackfrag"), bound to the request header -->
    <CheckBox
        id="confirmationCheckBox"
        selected="{NotifySecurity}"
        text="{i18n>acknowledgementText}"
        wrapping="true"
        editable="{ui>/isEditable}"
        class="confirmationCheckBox"/>
</core:FragmentDefinition>
