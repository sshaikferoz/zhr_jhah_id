{
  "_version": "1.60.0",
  "sap.app": {
    "id": "com.jhah.zhrjhahsecid1",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.29.0",
      "toolsId": "cb6de2e4-c05c-4543-b6ec-44bcc68acbb7"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsrv_hr_id_o4/srvd/sap/zsrv_hr_id_app/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      },
      "idConfigService": {
        "uri": "/sap/opu/odata4/sap/zsb_jhahsec_auth_o4/srvd_a2x/sap/zsrv_hr_jhahsec_auth_info/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/idConfigService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.39",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.jhah.zhrjhahsecid1.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "idConfig": {
        "dataSource": "idConfigService",
        "preload": false,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/custom.css",
          "id": "customcss"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "headerList",
          "target": "headerList"
        },
        {
          "pattern": "Header({key}):?query:",
          "name": "headerObjectPage",
          "target": "headerObjectPage"
        }
      ],
      "targets": {
        "headerList": {
          "type": "Component",
          "id": "headerList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Header",
              "variantManagement": "Page",
              "enhanceI18n": "i18n/fe.properties",
              "views": {
                "paths": [
                  {
                    "key": "HRTabKey",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#HRTab"
                  },
                  {
                    "key": "AdminTabKey",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#AdminTab"
                  },
                  {
                    "key": "EmpTabKey",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#EmpTab"
                  }
                ],
                "showCounts": false
              },
              "navigation": {
                "Header": {
                  "detail": {
                    "route": "headerObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "personalization": false
                  }
                },
                "@com.sap.vocabularies.UI.v1.LineItem#EmpList": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "personalization": false
                  }
                },
                "@com.sap.vocabularies.UI.v1.LineItem#HRList": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "personalization": false
                  }
                },
                "@com.sap.vocabularies.UI.v1.LineItem#AdminList": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "personalization": false
                  },
                  "actions": {
                    "IssueIdCard": {
                      "text": "{i18n>issueIdTitle}",
                      "press": "com.jhah.zhrjhahsecid1.ext.controller.IssueIdAction.onIssueIdFromList",
                      "requiresSelection": true,
                      "enabled": "com.jhah.zhrjhahsecid1.ext.controller.IssueIdAction.isSingleSelection"
                    },
                    "MaintainMasterData": {
                      "type": "Menu",
                      "text": "{i18n>maintainMasterData}",
                      "menu": [
                        "NavMaintainBlockedID",
                        "NavMaintainIDLocation",
                        "NavMaintainAccessArea"
                      ]
                    },
                    "NavMaintainBlockedID": {
                      "text": "{i18n>maintainBlockedIds}",
                      "icon": "sap-icon://locked",
                      "press": "com.jhah.zhrjhahsecid1.ext.controller.CustomActions.navigateToMaintainBlockedID"
                    },
                    "NavMaintainIDLocation": {
                      "text": "{i18n>maintainIdLocation}",
                      "icon": "sap-icon://map-2",
                      "press": "com.jhah.zhrjhahsecid1.ext.controller.CustomActions.navigateToMaintainIDLocation"
                    },
                    "NavMaintainAccessArea": {
                      "text": "{i18n>maintainAccessAreas}",
                      "icon": "sap-icon://building",
                      "press": "com.jhah.zhrjhahsecid1.ext.controller.CustomActions.navigateToMaintainAccessArea"
                    }
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "headerObjectPage": {
          "type": "Component",
          "id": "headerObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Header",
              "enhanceI18n": "i18n/fe.properties",
              "content": {
                "header": {
                  "actions": {
                    "IssueIdCard": {
                      "text": "{i18n>issueIdTitle}",
                      "press": "com.jhah.zhrjhahsecid1.ext.controller.IssueIdAction.onIssueIdFromObjectPage",
                      "visible": "{= ${__OperationControl/IssueID} === true && ${IsActiveEntity} === true }",
                      "position": {
                        "placement": "Before",
                        "anchor": "DataFieldForAction::com.sap.gateway.srvd.zsrv_hr_id_app.v0001.CancelRequest"
                      }
                    }
                  },
                  "facets": {
                    "CustomEmployeeHeader": {
                      "type": "XMLFragment",
                      "name": "com.jhah.zhrjhahsecid1.ext.fragment.EmployeeHeader"
                    }
                  }
                },
                "body": {
                  "sections": {
                    "GeneralTab": {
                      "subSections": {
                        "Ackfrag": {
                          "template": "com.jhah.zhrjhahsecid1.ext.fragment.Ackfrag",
                          "position": {
                            "placement": "After",
                            "anchor": "ReqSubSec"
                          },
                          "title": "{i18n>acknowledgementTitle}"
                        }
                      }
                    },
                    "ExistingAccessInfo": {
                      "template": "com.jhah.zhrjhahsecid1.ext.fragment.ExistingAccessInfo",
                      "title": "{i18n>existingAccessTitle}",
                      "position": {
                        "placement": "Before",
                        "anchor": "AccessAreaGroup"
                      },
                      "visible": "{= ${areaInfo>/lockedText} ? true : false }"
                    }
                  }
                }
              },
              "controlConfiguration": {
                "_items/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "personalization": false
                  },
                  "actions": {
                    "ActionSelectAreas": {
                      "text": "{i18n>selectAccessAreas}",
                      "press": ".extension.com.jhah.zhrjhahsecid1.ext.controller.ObjectPageExt.openAreaSelectionDialog",
                      "requiresSelection": false,
                      "visible": "{ui>/isEditable}"
                    }
                  }
                },
                "_ExistingAreas/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "personalization": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController#com.jhah.zhrjhahsecid1::headerList": {
            "controllerName": "com.jhah.zhrjhahsecid1.ext.controller.ListReportExt"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController#com.jhah.zhrjhahsecid1::headerObjectPage": {
            "controllerName": "com.jhah.zhrjhahsecid1.ext.controller.ObjectPageExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
