{
  "_version": "1.60.0",
  "sap.app": {
    "id": "com.jhah.zhrjhahsecid",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.29.0",
      "toolsId": "cb6de2e4-c05c-4543-b6ec-44bcc68acbb7"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsrv_hr_id_o4/srvd/sap/zsrv_hr_id_app/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.39",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.jhah.zhrjhahsecid.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/custom.css",
          "id": "customcss"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "headerList",
          "target": [
            "headerList"
          ]
        },
        {
          "pattern": "Header({key}):?query:",
          "name": "headerObjectPage",
          "target": [
            "headerList",
            "headerObjectPage"
          ]
        },
        {
          "pattern": "Header({key})/_items({key2}):?query:",
          "name": "appAreaObjectPage",
          "target": [
            "headerList",
            "headerObjectPage",
            "appAreaObjectPage"
          ]
        }
      ],
      "targets": {
        "headerList": {
          "type": "Component",
          "id": "headerList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Header",
              "variantManagement": "None",
              "navigation": {
                "Header": {
                  "detail": {
                    "route": "headerObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "headerObjectPage": {
          "type": "Component",
          "id": "headerObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Header",
              "content": {
                "header": {
                  "facets": {
                    "CustomEmployeeHeader": {
                      "type": "XMLFragment",
                      "requestGroupId": "$auto.Workers",
                      "name": "com.jhah.zhrjhahsecid.ext.fragment.EmployeeHeader"
                    }
                  }
                }
              },
              "navigation": {
                "_items": {
                  "detail": {
                    "route": "appAreaObjectPage"
                  }
                }
              }
            }
          }
        },
        "appAreaObjectPage": {
          "type": "Component",
          "id": "appAreaObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Header/_items"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "com.jhah.zhrjhahsecid.ext.controller.ObjectPageExt"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "com.jhah.zhrjhahsecid.ext.controller.ObjectPageExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}